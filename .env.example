# Optional overrides for docker compose (copy to .env)
JWT_SECRET=change-me-in-real-deployments
PUBLIC_URL=http://localhost:8080
# Minutes a batch may sit at one step before it is escalated (use 1 to demo it)
ESCALATION_MINUTES=1440
# Fake WhatsApp behaviour (0 to 1)
WA_FAIL_RATE=0.2
WA_TIMEOUT_RATE=0.1
# Requests per minute per IP address
RATE_LIMIT_LOGIN=20
RATE_LIMIT_PUBLIC=120
RATE_LIMIT_API=600
# WhatsApp retries: total attempts before a certificate is marked FAILED, and first retry delay (doubles each time)
WA_MAX_ATTEMPTS=6
WA_BACKOFF_MS=1000
